VAPID_SUBJECT=mailto:noreply@kamilunavo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
APNS_TEAM_ID=TKG684N5GL
APNS_KEY_ID=
APNS_PRIVATE_KEY_B64=
APNS_BUNDLE_ID=de.kamilunavo.zweicheck

# Android Firebase Cloud Messaging server credential.
# Full Firebase/Google service-account JSON, base64 encoded. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
# Optional explicit project id fallback when no service-account JSON is configured.
FIREBASE_PROJECT_ID=
